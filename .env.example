# Copy to `.env` and fill in. docker-compose and run-local.sh read it.
# For Railway/Render/Fly, set these as environment variables in the dashboard.

# --- Web UI login -----------------------------------------------------------
# Comma-separated user:password pairs. Passwords may NOT contain ',' or ':'.
# NOTE: keep real passwords here (gitignored) or in your host's secrets —
# never commit them.
APP_USERS=Lander:1234,someone@example.com:change-me

# Secret used to sign session cookies. Set a long random value in production
# (e.g. `openssl rand -hex 32`). If unset, a random per-process key is used
# (sessions drop on every restart).
APP_SECRET=

# Session lifetime in seconds (default 86400 = 1 day).
APP_SESSION_TTL=86400

# --- cis-bench --------------------------------------------------------------
# production (default) | dev | test
CIS_BENCH_ENV=production
# Set to "false" ONLY behind a TLS-intercepting proxy.
CIS_BENCH_SSL_VERIFY=true
# Version of the CLI baked into the image (docker compose build arg).
CIS_BENCH_VERSION=0.5.2

# Optional: pre-authenticate on startup from a base64-encoded Netscape
# cookies.txt (so a headless deploy is signed in without committing cookies).
#   base64 -w0 cookies.txt   # then paste the output here / as a secret
CIS_COOKIES_B64=

# --- Optional AI drafting (Claude API) --------------------------------------
# When set, the policy generator drafts the narrative sections (Purpose, Scope,
# Roles, Compliance) with Claude, tailored to the benchmark. CIS controls stay
# verbatim. Without it, built-in static templates are used.
ANTHROPIC_API_KEY=
# Model for the narrative drafting (default claude-opus-5). Use e.g.
# claude-sonnet-5 to reduce cost.
POLICY_LLM_MODEL=claude-opus-5
