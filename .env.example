# Copy to `.env` and adjust as needed. docker-compose reads this automatically.
# (The CLI itself also reads /data/.cis-bench/.env inside the container.)

# Application environment: production | dev | test
CIS_BENCH_ENV=production

# Set to "false" ONLY when going through a TLS-intercepting proxy.
CIS_BENCH_SSL_VERIFY=true

# Version of the CLI baked into the image (used by docker compose build args).
CIS_BENCH_VERSION=0.5.2
