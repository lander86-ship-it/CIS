# Runtime state persisted by the container (session cookies, catalog.db, .env)
/data/*
!/data/.gitkeep

# Exported benchmarks
/work/*
!/work/.gitkeep

# Secrets / auth material — never commit these
.env
*.cookies
cookies.txt

# Python / venv
.venv/
__pycache__/
*.pyc

# OS / editor noise
.DS_Store
*.swp
.idea/
.vscode/
